{
  "name": "fintrack",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "dev:all": "node scripts/dev.ts",
    "dev": "npm run dev -w @fintrack/web",
    "e2e": "playwright test",
    "perf": "vitest run --config vitest.perf.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
